    "dicom-parser": "^1.8.21",
    "dotenv": "^17.2.3",
    "events": "^3.3.0",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
