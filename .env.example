# Obligatoria para análisis, dictado y generación con IA.
# Crea una clave en https://aistudio.google.com/apikey y no la publiques.
GEMINI_API_KEY=

# Opcional. URL pública o local de la aplicación.
APP_URL=http://localhost:3000

# Cloud Run proporciona PORT automáticamente. En desarrollo se usa 3000.
PORT=3000

# Configuración pública de tu propia aplicación web de Firebase, en una línea.
# En local es opcional; Cloud Run la usará sin escribir en su disco temporal.
# FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
